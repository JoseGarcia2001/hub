# === IBKR Client Portal Web API — gateway local (ver ~/Personal/vida-adulta/finanzas/inversiones/) ===
# Arrancar el gateway: ./cpgateway-run.sh  y autenticar en https://localhost:5055
IBKR_CPAPI_BASE="https://localhost:5055/v1/api"
# Opcional: si se omite, se toma la primera cuenta de /portfolio/accounts
IBKR_ACCOUNT_ID=""

# === Base de datos ===
DATABASE_URL="postgresql://USER@localhost:5432/hub"

# === Better Auth ===
# Genera el secret con: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Correos autorizados a tener cuenta (coma-separados).
AUTH_ALLOWED_EMAILS=""

# === Google OAuth (console.cloud.google.com → Credentials → OAuth client ID, Web) ===
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
