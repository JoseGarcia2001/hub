# Copiar a `.env` (mismo directorio que docker-compose.yml) y llenar.
# `.env` está gitignored: NUNCA commitear secretos.

# --- Postgres (contenedor) ---
# Generar: openssl rand -base64 24
POSTGRES_PASSWORD=

# --- Better Auth ---
# Generar uno NUEVO para prod (distinto al de dev): openssl rand -base64 32
BETTER_AUTH_SECRET=
# Correos autorizados a entrar (coma-separados)
AUTH_ALLOWED_EMAILS=tu-correo@gmail.com

# --- Google OAuth (producción) ---
# En console.cloud.google.com, al cliente OAuth Web agregar:
#   Authorized redirect URI:  https://hub.jogadev.com/api/auth/callback/google
#   Authorized JS origin:     https://hub.jogadev.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Inversiones: IBKR Flex Web Service (headless, recomendado) ---
# La ingesta automática (cron → POST /api/cron/ingest) lee el portafolio sin gateway
# ni login interactivo. Configurar la Flex Query y el token en Client Portal:
#   Settings/Reporting → Flex Queries → crear una Activity Flex Query con las secciones
#   "Net Asset Value (NAV) in Base" y "Open Positions" (nivel Summary; campos: conid,
#   symbol, description, position, markPrice, positionValue, costBasisPrice,
#   fifoPnlUnrealized, currency, fxRateToBase) → anotar el Query ID.
#   Reporting → Flex Web Service Configuration → generar el token.
INVESTMENTS_SOURCE=flex
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=
# Secret del endpoint de ingesta (el cron lo manda como Bearer). Generar: openssl rand -hex 32
INGEST_SECRET=

# --- IBKR cp-rest (opcional; gateway local, no se usa en el server) ---
# Solo si INVESTMENTS_SOURCE=cp-rest. Por defecto apunta a host.docker.internal:5055.
IBKR_CPAPI_BASE=
IBKR_ACCOUNT_ID=

# --- Caja: sync de respaldo contra Gmail ---
# El Worker de Cloudflare empuja cada correo del banco al hub, pero si el server está
# apagado ese POST se pierde sin reintento. El cron llama /api/cron/caja-sync y el hub
# va a buscar a Gmail lo que le falte (idempotente por Message-ID).
# Cliente OAuth de tipo Desktop del mismo proyecto GCP; scope gmail.readonly.
# La app OAuth debe estar publicada "In production": en modo Testing, Google caduca
# el refresh token cada 7 días y el sync se apaga solo.
# Sin las tres variables el endpoint responde 503 y el resto del hub sigue igual.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- Web Push (VAPID) ---
# Notificaciones al celular. Generar UN par (distinto al de dev):
#   npx web-push generate-vapid-keys --json
# La pública viaja al navegador (no es secreto); la privada firma los envíos (SECRETA).
# Sin estas claves el push queda apagado y el toggle no se muestra.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@gmail.com

# Nota: BETTER_AUTH_URL=https://hub.jogadev.com está fijo en docker-compose.yml (no es secreto).
